    "/assistant/messages": {
      "post": {
        "operationId": "messages_assistant_messages_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MessageIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "description": "Server-sent events, one JSON object per `data:` line, `event:` naming the type:\n`conversation` {conversation_id}, `progress` {tool, label}, `delta` {text}, `step` {},\n`pending_approval` {approval}, `clarify` {options, text}, `message` {text, outcome}, `error` {message}, `done` {}.\n`delta` text is provisional: on `step` discard what has streamed so far; `message.text` is the reply."
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GuardError"
                }
              }
            },
            "description": "missing or wrong token"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GuardError"
                }
              }
            },
            "description": "agent tokens can only use /mcp"
          },
          "421": {
