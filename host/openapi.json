          "name",
          "state",
          "loaded",
          "ollama_reachable",
          "ollama_started_by_host"
        ],
        "title": "ModelOut",
        "type": "object"
      },
      "Progress": {
        "properties": {
          "completed": {
            "title": "Completed",
            "type": "integer"
          },
          "percent": {
            "title": "Percent",
            "type": "number"
          },
          "status": {
            "title": "Status",
            "type": "string"
          },
          "total": {
            "title": "Total",
            "type": "integer"
          }
        },
        "required": [
          "status",
          "completed",
          "total",
          "percent"
        ],
        "title": "Progress",
        "type": "object"
      },
      "StatusOut": {
        "properties": {
          "agents_connected": {
            "description": "agent tokens used in the last five minutes",
            "title": "Agents Connected",
            "type": "integer"
          },
          "demo_date": {
            "description": "true while today is pinned to the demo data's date",
            "title": "Demo Date",
            "type": "boolean"
          },
          "model": {
            "$ref": "#/components/schemas/ModelOut"
          },
          "ready": {
            "description": "true when the assistant can answer",
            "title": "Ready",
            "type": "boolean"
          },
          "today": {
            "description": "the date the host treats as today",
            "title": "Today",
            "type": "string"
          },
          "uptime_seconds": {
            "title": "Uptime Seconds",
            "type": "number"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "version",
          "ready",
          "uptime_seconds",
          "model",
          "agents_connected",
          "today",
          "demo_date"
        ],
        "title": "StatusOut",
        "type": "object"
      },
      "ToolOut": {
        "properties": {
          "description": {
            "title": "Description",
            "type": "string"
          },
          "input_schema": {
            "additionalProperties": true,
            "title": "Input Schema",
            "type": "object"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "permission": {
            "enum": [
              "read",
              "reversible",
              "irreversible"
