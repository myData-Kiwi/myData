                "schema": {
                  "$ref": "#/components/schemas/GuardError"
                }
              }
            },
            "description": "the Host header is not this machine"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "503": {
            "description": "the model is not ready yet; see GET /status"
          }
        },
        "summary": "Messages"
      }
    },
