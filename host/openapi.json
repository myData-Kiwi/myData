            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "created_at",
          "revoked",
          "connected",
          "token"
        ],
        "title": "AgentCreated",
        "type": "object"
      },
      "AgentIn": {
        "properties": {
          "name": {
            "maxLength": 64,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "title": "AgentIn",
        "type": "object"
      },
      "AgentOut": {
        "properties": {
          "connected": {
            "title": "Connected",
            "type": "boolean"
          },
          "created_at": {
            "title": "Created At",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "last_seen_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Seen At"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "revoked": {
            "title": "Revoked",
            "type": "boolean"
          },
          "revoked_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Revoked At"
          }
        },
        "required": [
          "id",
          "name",
          "created_at",
          "revoked",
          "connected"
        ],
        "title": "AgentOut",
        "type": "object"
      },
      "ApprovalOut": {
        "properties": {
          "args": {
            "additionalProperties": true,
            "description": "exactly what will run if approved",
            "title": "Args",
            "type": "object"
          },
          "caller": {
            "title": "Caller",
            "type": "string"
          },
          "context": {
            "additionalProperties": true,
            "default": {},
            "title": "Context",
            "type": "object"
          },
          "created_at": {
            "title": "Created At",
            "type": "string"
          },
          "decided_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Decided At"
          },
          "decided_by": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
