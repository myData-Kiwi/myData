          "421": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GuardError"
                }
              }
            },
            "description": "the Host header is not this machine"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Revoke Agent"
      }
    },
    "/approvals": {
