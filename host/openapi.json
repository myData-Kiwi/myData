  "info": {
    "description": "Local API of the myData host. Listens on localhost only; every request needs `Authorization: Bearer <token>` from the token file in the host's folder.",
    "title": "myData host",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/agents": {
      "get": {
        "operationId": "agents_agents_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/AgentOut"
                  },
                  "title": "Response Agents Agents Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GuardError"
                }
              }
            },
            "description": "missing or wrong token"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GuardError"
                }
              }
            },
            "description": "agent tokens can only use /mcp"
          },
          "421": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GuardError"
                }
              }
            },
            "description": "the Host header is not this machine"
          }
        },
        "summary": "Agents"
      },
      "post": {
        "operationId": "create_agent_agents_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AgentIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentCreated"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GuardError"
                }
              }
            },
            "description": "missing or wrong token"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GuardError"
                }
              }
            },
            "description": "agent tokens can only use /mcp"
          },
          "421": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GuardError"
                }
              }
            },
            "description": "the Host header is not this machine"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Create Agent"
      }
    },
