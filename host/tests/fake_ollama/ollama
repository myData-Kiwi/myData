#!/usr/bin/env python3
"""Stand-in for `ollama serve` in tests: answers the few endpoints the host uses, on $OLLAMA_HOST."""
import json, os, sys, time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

if sys.argv[1:] != ["serve"]:
    sys.exit(2)
host, port = os.environ["OLLAMA_HOST"].rsplit(":", 1)
state = {"models": [], "loaded": []}
open(os.environ["FAKE_OLLAMA_PIDFILE"], "w").write(str(os.getpid()))


class H(BaseHTTPRequestHandler):
    def log_message(self, *a):
        pass

    def _json(self, obj):
        body = json.dumps(obj).encode()
        self.send_response(200)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def do_GET(self):
        if self.path == "/api/version":
            return self._json({"version": "fake"})
        if self.path == "/api/tags":
            return self._json({"models": [{"name": m} for m in state["models"]]})
        if self.path == "/api/ps":
            return self._json({"models": [{"name": m} for m in state["loaded"]]})
        self.send_error(404)

    def do_POST(self):
        payload = json.loads(self.rfile.read(int(self.headers["Content-Length"])))
        if self.path == "/api/pull":
            self.send_response(200)
            self.send_header("Content-Type", "application/x-ndjson")
            self.end_headers()
            for done in (0, 50, 100):
                self.wfile.write((json.dumps({"status": "pulling", "completed": done, "total": 100}) + "\n").encode())
                self.wfile.flush()
                time.sleep(0.2)
            self.wfile.write(b'{"status": "success"}\n')
            state["models"].append(payload["model"])
            return
        if self.path == "/api/chat":
            time.sleep(0.3)  # loading a model takes a moment
            state["loaded"].append(payload["model"])
            return self._json({"message": {"content": ""}, "done": True})
        self.send_error(404)


ThreadingHTTPServer((host, int(port)), H).serve_forever()
