    },
    "sidebar": "solid",
    "bars": "solid"
  },
  "icons": {
    "set": "phosphor",
    "weight": "light",
    "selected": "same",
    "tiles": "none"
  },
  "motion": {
    "personality": "calm",
    "scale": 1,
    "press": "dim",
    "enter": "fade"
  },
  "components": {
    "button": {
      "primary": "outline",
      "secondary": "text",
      "shape": "square"
    },
    "list": "ruled",
    "sidebar": "column",
    "toolbar": "flat",
    "inputs": "underlined",
    "selection": "bar",
    "avatar": "none",
    "tabs": "underline",
    "chat": "transcript",
    "month": "open",
    "today": "ring",
