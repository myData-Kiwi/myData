  "colour-use": {
    "same-as": {
      "toolbar": "bg",
      "edge": "ink"
    }
  },
  "type": {
    "display": [
      "fraunces",
      "serif"
    ],
    "body": [
      "instrument-sans",
      "sans"
    ],
    "mono": [
      "jetbrains-mono",
      "mono"
    ],
    "base": 15,
    "ratio": 1.25,
    "numerals": "proportional",
    "secondary-italic": true,
    "roles": {
      "display-xl": {
        "size": 44,
        "line-height": 1.1,
        "weight": 600,
        "tracking": -0.02
      },
      "display-lg": {
        "size": 34,
        "line-height": 1.12,
        "weight": 600,
        "tracking": -0.015
      },
      "title": {
        "size": 24,
        "line-height": 1.2,
        "weight": 600,
        "tracking": -0.01
      },
      "heading": {
        "size": 16,
        "line-height": 1.4,
        "weight": 600,
        "tracking": 0.01
      },
      "body": {
        "size": 15,
        "line-height": 1.55,
        "weight": 400,
        "tracking": 0
      },
      "body-strong": {
        "size": 15,
        "line-height": 1.55,
        "weight": 600,
        "tracking": 0
      },
      "label": {
        "size": 13,
        "line-height": 1.4,
        "weight": 500,
        "tracking": 0.01
      },
      "caption": {
        "size": 13,
        "line-height": 1.4,
        "weight": 400,
        "tracking": 0
      },
      "mono": {
        "size": 13,
        "line-height": 1.5,
        "weight": 400,
        "tracking": 0
      }
    }
  },
  "shape": {
    "corners": "square",
    "radius": {
      "xs": 2,
      "sm": 2,
      "md": 2,
      "lg": 2,
      "xl": 4
    },
    "controls": "match"
  },
  "density": {
    "desktop": {
      "control": 36,
      "row": 52,
      "icon": 18,
      "space": 1.25
    },
    "phone": {
      "control": 48,
      "row": 60,
      "icon": 22,
      "space": 1.25
    }
  },
  "borders": {
    "width": 1,
    "style": "solid",
    "colour": "edge",
    "cards": false,
    "controls": true,
    "separators": "full",
    "title-rule": "double"
  },
  "elevation": {
    "style": "none",
    "strength": 0,
    "offset": 0,
    "press": "none"
  },
  "materials": {
