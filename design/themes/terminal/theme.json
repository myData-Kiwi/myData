    "same-as": {
      "selection": "ink",
      "on-selection": "bg",
      "toolbar": "sidebar"
    }
  },
  "type": {
    "display": [
      "jetbrains-mono",
      "mono"
    ],
    "body": [
      "jetbrains-mono",
      "mono"
    ],
    "mono": [
      "jetbrains-mono",
      "mono"
    ],
    "base": 13,
    "ratio": 1.067,
    "numerals": "tabular",
    "secondary-italic": false,
    "roles": {
      "display-xl": {
        "size": 20,
        "line-height": 1.3,
        "weight": 700,
        "tracking": 0
      },
      "display-lg": {
        "size": 17,
        "line-height": 1.3,
        "weight": 700,
        "tracking": 0
      },
      "title": {
        "size": 15,
        "line-height": 1.33,
        "weight": 700,
        "tracking": 0
      },
      "heading": {
        "size": 14,
        "line-height": 1.43,
        "weight": 700,
        "tracking": 0
      },
      "body": {
        "size": 13,
        "line-height": 1.54,
        "weight": 400,
        "tracking": 0
      },
      "body-strong": {
        "size": 13,
        "line-height": 1.54,
        "weight": 700,
        "tracking": 0
      },
      "label": {
        "size": 12,
        "line-height": 1.5,
        "weight": 700,
        "tracking": 0.04,
        "case": "upper"
      },
      "caption": {
        "size": 12,
        "line-height": 1.5,
        "weight": 400,
        "tracking": 0
      },
      "mono": {
        "size": 13,
        "line-height": 1.54,
        "weight": 400,
        "tracking": 0
      }
    }
  },
  "shape": {
    "corners": "square",
    "radius": {
      "xs": 0,
      "sm": 0,
      "md": 0,
      "lg": 0,
      "xl": 0
    },
    "controls": "match"
  },
  "density": {
    "desktop": {
      "control": 28,
      "row": 28,
      "icon": 16,
      "space": 0.75
    },
    "phone": {
      "control": 44,
      "row": 48,
      "icon": 20,
      "space": 1
    }
  },
  "borders": {
    "width": 1,
    "style": "solid",
    "colour": "edge",
    "cards": true,
    "controls": true,
    "separators": "none",
    "title-rule": "single"
  },
  "elevation": {
    "style": "none",
    "strength": 0,
    "offset": 0,
    "press": "none"
  },
  "materials": {
    "window": {
      "kind": "solid"
    },
    "sidebar": "solid",
    "bars": "solid"
  },
  "icons": {
    "set": "lucide",
    "weight": "regular",
    "selected": "same",
    "tiles": "none"
  },
  "motion": {
    "personality": "none",
    "scale": 1,
    "press": "invert",
    "enter": "none"
  },
  "components": {
    "button": {
      "primary": "filled",
      "secondary": "outline",
      "shape": "square"
    },
    "list": "plain",
    "sidebar": "column",
    "toolbar": "flat",
    "inputs": "underlined",
    "selection": "inverse",
    "avatar": "none",
    "tabs": "boxed",
    "chat": "transcript",
    "month": "table",
    "today": "inverse",
