        "size": 15,
        "line-height": 1.45,
        "weight": 400
      },
      "body-strong": {
        "size": 15,
        "line-height": 1.45,
        "weight": 600
      },
      "label": {
        "size": 12,
        "line-height": 1.3,
        "weight": 600,
        "tracking": 0.1,
        "case": "upper"
      },
      "caption": {
        "size": 13,
        "line-height": 1.35,
        "weight": 400
      },
      "mono": {
        "size": 13,
        "line-height": 1.4,
        "weight": 400
      }
    },
    "numerals": "tabular",
    "secondary-italic": false
