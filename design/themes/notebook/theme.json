        "size": 20,
        "line-height": 1.4,
        "weight": 700,
        "tracking": 0,
        "stack": "display"
      },
      "body": {
        "size": 16,
        "line-height": 1.75,
        "weight": 400,
        "tracking": 0
      },
      "body-strong": {
        "size": 16,
        "line-height": 1.75,
        "weight": 600,
        "tracking": 0
      },
      "label": {
        "size": 14,
        "line-height": 1.43,
        "weight": 600,
        "tracking": 0.01
