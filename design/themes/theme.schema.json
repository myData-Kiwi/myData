            "bold",
            "fill"
          ],
          "description": "Mapped to the nearest weight the set has."
        },
        "selected": {
          "enum": [
            "same",
            "fill"
          ],
          "description": "fill: the current sidebar section's icon is filled where the set has a fill."
        },
