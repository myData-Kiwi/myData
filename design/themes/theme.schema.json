          ]
        }
      }
    },
    "components": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "button": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "primary": {
              "enum": [
                "filled",
                "outline",
                "brutal",
                "bevel",
                "push"
              ],
              "description": "Never text: a primary action must look like a button."
            },
            "secondary": {
              "enum": [
