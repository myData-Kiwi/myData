  "default-palette": "blue",
  "colour-use": {
    "same-as": {
      "selection": "ink",
      "on-selection": "bg",
      "edge": "ink",
      "line-strong": "ink"
    }
  },
  "type": {
    "display": [
      "atkinson-hyperlegible-next",
      "sans"
    ],
    "body": [
      "atkinson-hyperlegible-next",
      "sans"
    ],
    "mono": [
      "atkinson-hyperlegible-mono",
      "mono"
    ],
    "base": 16,
    "ratio": 1.2,
    "numerals": "tabular",
    "secondary-italic": false,
    "roles": {
      "display-xl": {
        "size": 40,
        "line-height": 1.15,
        "weight": 800,
        "tracking": -0.01
      },
      "display-lg": {
        "size": 30,
        "line-height": 1.2,
        "weight": 800,
        "tracking": -0.01
      },
      "title": {
        "size": 22,
        "line-height": 1.27,
        "weight": 800,
        "tracking": 0
      },
      "heading": {
        "size": 18,
        "line-height": 1.33,
        "weight": 700,
        "tracking": 0
      },
      "body": {
        "size": 16,
        "line-height": 1.5,
        "weight": 400,
        "tracking": 0.01
      },
      "body-strong": {
        "size": 16,
        "line-height": 1.5,
        "weight": 700,
        "tracking": 0.01
      },
      "label": {
        "size": 15,
        "line-height": 1.4,
        "weight": 700,
        "tracking": 0.01
      },
      "caption": {
        "size": 14,
        "line-height": 1.43,
        "weight": 400,
        "tracking": 0.01
      },
      "mono": {
        "size": 15,
        "line-height": 1.47,
        "weight": 400,
        "tracking": 0
      }
    }
  },
  "shape": {
    "corners": "round",
    "radius": {
      "xs": 4,
      "sm": 8,
      "md": 8,
      "lg": 8,
      "xl": 12
    },
    "controls": "match"
  },
  "density": {
    "desktop": {
      "control": 40,
      "row": 48,
      "icon": 20,
      "space": 1
    },
    "phone": {
      "control": 48,
      "row": 56,
      "icon": 24,
      "space": 1
    }
  },
  "borders": {
    "width": 2,
    "style": "solid",
    "colour": "edge",
    "cards": true,
    "controls": true,
    "separators": "full",
    "title-rule": "single",
    "focus": "double"
  },
  "elevation": {
    "style": "none",
    "strength": 0,
    "press": "none"
  },
  "materials": {
