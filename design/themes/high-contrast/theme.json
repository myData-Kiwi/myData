    "sidebar": "solid",
    "bars": "solid"
  },
  "icons": {
    "set": "material-outlined",
    "weight": "bold",
    "selected": "fill",
    "tiles": "outlined"
  },
  "motion": {
    "personality": "calm",
    "scale": 0.75,
    "press": "dim",
    "enter": "fade"
  },
  "components": {
    "button": {
      "primary": "filled",
      "secondary": "outline",
      "plain": "underline",
