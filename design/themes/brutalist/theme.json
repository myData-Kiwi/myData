      "display-lg": {
        "size": 32,
        "line-height": 1.1,
        "weight": 400,
        "tracking": -0.015
      },
      "title": {
        "size": 24,
        "line-height": 1.15,
        "weight": 400,
        "tracking": -0.01
      },
      "heading": {
        "size": 18,
        "line-height": 1.25,
        "weight": 400,
        "stack": "display"
      },
      "body": {
        "size": 15,
        "line-height": 1.4,
        "weight": 400
      },
      "body-strong": {
        "size": 15,
        "line-height": 1.4,
        "weight": 700
      },
      "label": {
        "size": 12,
        "line-height": 1.3,
        "weight": 700,
        "tracking": 0.06,
