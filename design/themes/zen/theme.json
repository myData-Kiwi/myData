      "sans"
    ],
    "mono": [
      "jetbrains-mono",
      "mono"
    ],
    "base": 15,
    "ratio": 1.2,
    "numerals": "proportional",
    "secondary-italic": false,
    "roles": {
      "display-xl": {
        "size": 34,
        "line-height": 1.3,
        "weight": 600,
        "tracking": 0.04
      },
      "display-lg": {
        "size": 27,
        "line-height": 1.3,
        "weight": 600,
        "tracking": 0.05
      },
      "title": {
        "size": 22,
        "line-height": 1.4,
        "weight": 600,
        "tracking": 0.06
      },
      "heading": {
        "size": 16,
        "line-height": 1.5,
        "weight": 600,
        "tracking": 0.04,
        "stack": "display"
      },
      "body": {
        "size": 15,
        "line-height": 1.75,
        "weight": 400,
        "tracking": 0.01
      },
      "body-strong": {
        "size": 15,
        "line-height": 1.75,
        "weight": 500,
        "tracking": 0.01
      },
      "label": {
        "size": 12.5,
        "line-height": 1.5,
        "weight": 500,
        "tracking": 0.04
      },
      "caption": {
        "size": 12.5,
        "line-height": 1.6,
        "weight": 400,
        "tracking": 0.02
      },
      "mono": {
        "size": 12.5,
        "line-height": 1.5,
        "weight": 400,
        "tracking": 0
      }
    }
